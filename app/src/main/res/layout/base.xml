<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#0A0A0A"
	android:orientation="horizontal"
	android:weightSum="10">
	<LinearLayout
		android:id="@+id/baseMain"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@drawable/fundo_home"
		android:orientation="horizontal">
		<LinearLayout
			android:id="@+id/sidebarLeft"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:paddingTop="30dp"
			android:paddingBottom="30dp"
			android:background="#000000"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:alpha="0.6">
			<ImageView
				android:id="@+id/imageview5"
				android:layout_width="60dp"
				android:layout_height="55dp"
				android:layout_marginBottom="30dp"
				android:scaleType="fitXY" />
			<View
				android:id="@+id/view44"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:layout_weight="1" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear_centro_main"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:layout_weight="10">
			<TextView
				android:id="@+id/logoText"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:gravity="center_horizontal|center_vertical"
				android:text="Aura Launcher"
				android:textSize="32sp"
				android:textStyle="bold"
				android:textColor="#00E5FF"
				android:layout_gravity="left"
				android:translationX="-63.0dp"
				android:alpha="0.5"
				android:shadowColor="#00E5FF"
				android:shadowDx="0"
				android:shadowDy="0"
				android:shadowRadius="15" />
			<View
				android:id="@+id/view45"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:layout_weight="1" />
			<FrameLayout
				android:id="@+id/frame_layout46"
				android:layout_width="match_parent"
				android:layout_height="220dp"
				android:layout_marginLeft="40dp"
				android:layout_marginRight="40dp">
				<LinearLayout
					android:id="@+id/glassCard"
					android:layout_width="match_parent"
					android:layout_height="220dp"
					android:background="@drawable/bg_vidro_neon"
					android:orientation="horizontal"
					android:weightSum="10">
					<LinearLayout
						android:id="@+id/linear34"
						android:layout_width="1dp"
						android:layout_height="wrap_content"
						android:padding="24dp"
						android:orientation="vertical"
						android:layout_weight="6">
						<TextView
							android:id="@+id/textview28"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Aura Roleplay "
							android:textSize="22sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF"
							android:shadowColor="#000000"
							android:shadowRadius="5" />
						<TextView
							android:id="@+id/textview29"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="8dp"
							android:text="O melhor RP do Brasil com sistemas únicos e economia balanceada. Entre e faça sua história!"
							android:textSize="14sp"
							android:textColor="#E0E0E0"
							android:alpha="0.8"
							android:shadowColor="#000000"
							android:shadowRadius="3" />
						<Button
							android:id="@+id/btnJogar"
							android:layout_width="210dp"
							android:layout_height="wrap_content"
							android:layout_marginTop="20dp"
							android:background="@drawable/btn_cyan_glow"
							android:gravity="center_horizontal|center_vertical"
							android:text="JOGAR ▶▶"
							android:textSize="18sp"
							android:textStyle="bold"
							android:textColor="#FFFFFF" />
					</LinearLayout>
					<View
						android:id="@+id/view47"
						android:layout_width="1dp"
						android:layout_height="match_parent"
						android:layout_weight="4" />
				</LinearLayout>
				<ImageView
					android:id="@+id/characterImage"
					android:layout_width="250dp"
					android:layout_height="350dp"
					android:src="@drawable/boneco_home"
					android:scaleType="centerInside"
					android:layout_gravity="right|center_vertical" />
			</FrameLayout>
			<View
				android:id="@+id/view48"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:layout_weight="1" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/sidebarRight"
			android:layout_width="220dp"
			android:layout_height="match_parent"
			android:padding="20dp"
			android:background="#000000"
			android:gravity="right"
			android:orientation="vertical"
			android:layout_gravity="center_horizontal|center_vertical"
			android:alpha="0.6">
			<TextView
				android:id="@+id/textview30"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="20dp"
				android:text="SERVER : "
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="#FFFFFF"
				android:layout_gravity="center_horizontal" />
			<LinearLayout
				android:id="@+id/linear35"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="15dp"
				android:background="@drawable/bg_status_server"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal"
				android:layout_gravity="center_horizontal|center_vertical">
				<ImageView
					android:id="@+id/imageview8"
					android:layout_width="30dp"
					android:layout_height="30dp"
					android:scaleType="center"
					android:src="@android:drawable/ic_menu_myplaces"
					android:tint="#00E5FF" />
				<LinearLayout
					android:id="@+id/linear36"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_marginStart="10dp">
					<TextView
						android:id="@+id/textview32"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Jogadores"
						android:textSize="12sp"
						android:textColor="#AAAAAA" />
					<TextView
						android:id="@+id/textview31"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="145 / 500"
						android:textSize="16sp"
						android:textStyle="bold"
						android:textColor="#00E5FF" />
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear37"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:background="@drawable/bg_status_server"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal"
				android:layout_gravity="center_horizontal|center_vertical">
				<TextView
					android:id="@+id/textview33"
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:background="#4CAF50"
					android:textSize="12sp"
					android:translationX="-2.0dp" />
				<LinearLayout
					android:id="@+id/linear38"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_marginStart="10dp">
					<TextView
						android:id="@+id/textview34"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="STATUS"
						android:textSize="10sp"
						android:textColor="#AAAAAA" />
					<TextView
						android:id="@+id/textview35"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="ONLINE"
						android:textSize="14sp"
						android:textStyle="bold"
						android:textColor="#00FF00" />
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
